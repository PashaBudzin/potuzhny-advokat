{
    "name": "@potuzhny-advokat/ecourt-api",
    "version": "0.1.0",
    "private": false,
    "description": "Strongly typed TypeScript client for the Ukrainian Electronic Court corporate API (API Електронного суду)",
    "keywords": [
        "api",
        "court",
        "ecourt",
        "typescript",
        "ukraine"
    ],
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "tsc --noEmit",
        "check-types": "tsc --noEmit"
    },
    "devDependencies": {
        "typescript": "^5"
    },
    "engines": {
        "node": ">=18"
    }
