{
    "manifest_version": 3,
    "name": "Court Cabinet Helper",
    "version": "1.0.0",
    "description": "Helper for cabinet.court.gov.ua",
    "permissions": ["storage"],
    "host_permissions": ["https://cabinet.court.gov.ua/*"],
    "icons": {
        "16": "icon/16.png",
        "32": "icon/32.png",
        "48": "icon/48.png",
        "96": "icon/96.png",
        "128": "icon/128.png"
    },
    "action": {
        "default_popup": "src/popup.html"
    },
    "background": {
        "service_worker": "src/lib/background.ts"
    },
    "content_scripts": [
        {
            "matches": ["https://cabinet.court.gov.ua/*"],
            "js": ["src/lib/interceptor.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://cabinet.court.gov.ua/*"],
            "js": ["src/lib/bridge.ts"],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ]
}
